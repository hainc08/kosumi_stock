// prisma/schema.prisma
// WMS — Warehouse Management System
// MariaDB / MySQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  WAREHOUSE_MANAGER
  ACCOUNTANT
  WAREHOUSE_STAFF
  VIEWER
}

enum ReceiptStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum IssueStatus {
  DRAFT
  PENDING
  APPROVED
  CONFIRMED
  REJECTED
}

enum IssueRequestStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum NotificationType {
  ISSUE_REQUEST_NEW
  ISSUE_REQUEST_APPROVED
  ISSUE_REQUEST_REJECTED
}

// ─── TABLES ───────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  username     String   @unique @db.VarChar(50)
  email        String   @unique @db.VarChar(100)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  fullName     String   @map("full_name") @db.VarChar(100)
  role         Role
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  // Relations
  createdReceipts  Receipt[]  @relation("ReceiptCreatedBy")
  approvedReceipts Receipt[]  @relation("ReceiptApprovedBy")
  createdIssues    Issue[]    @relation("IssueCreatedBy")
  approvedIssues   Issue[]    @relation("IssueApprovedBy")
  confirmedIssues  Issue[]    @relation("IssueConfirmedBy")
  requestedIssues  IssueRequest[] @relation("IssueRequestedBy")
  reviewedIssues   IssueRequest[] @relation("IssueReviewedBy")
  closedPeriods    InventoryPeriod[]
  auditLogs        AuditLog[]
  notifications    Notification[]

  @@map("users")
}

model Product {
  id        String  @id @default(uuid())
  code      String  @unique @db.VarChar(20)   // ON1, T1, ...
  name      String  @db.VarChar(200)
  unit      String  @db.VarChar(20)            // ống, Tấm, ...
  category  String? @db.VarChar(50)            // Ống, Tấm, Đen, ...
  minStock  Int     @default(0) @map("min_stock")
  isActive  Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  // Relations
  balances     InventoryBalance[]
  receiptItems ReceiptItem[]
  issueItems   IssueItem[]
  issueRequestItems IssueRequestItem[]

  @@map("products")
}

model Unit {
  id        String   @id @default(uuid())
  code      String   @unique @db.VarChar(20)
  name      String   @unique @db.VarChar(50)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@map("units")
}

model ProductCategory {
  id        String   @id @default(uuid())
  code      String   @unique @db.VarChar(20)
  name      String   @unique @db.VarChar(50)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@map("product_categories")
}

model InventoryPeriod {
  id        String    @id @default(uuid())
  year      Int       @db.SmallInt
  month     Int       @db.SmallInt
  isClosed  Boolean   @default(false) @map("is_closed")
  closedAt  DateTime? @map("closed_at") @db.DateTime(3)
  closedBy  String?   @map("closed_by")
  closedByUser User?  @relation(fields: [closedBy], references: [id])

  // Relations
  balances InventoryBalance[]
  receipts Receipt[]
  issues   Issue[]
  issueRequests IssueRequest[]

  @@unique([year, month])
  @@map("inventory_periods")
}

model InventoryBalance {
  id           String @id @default(uuid())
  periodId     String @map("period_id")
  productId    String @map("product_id")
  openingQty   Decimal @default(0) @map("opening_qty") @db.Decimal(12, 2)
  openingValue Decimal @default(0) @map("opening_value") @db.Decimal(18, 2)
  closingQty   Decimal @default(0) @map("closing_qty") @db.Decimal(12, 2)
  closingValue Decimal @default(0) @map("closing_value") @db.Decimal(18, 2)

  period  InventoryPeriod @relation(fields: [periodId], references: [id])
  product Product         @relation(fields: [productId], references: [id])

  @@unique([periodId, productId])
  @@map("inventory_balance")
}

model Receipt {
  id          String        @id @default(uuid())
  receiptNo   String        @unique @map("receipt_no") @db.VarChar(20) // PN-2026-001
  periodId    String?       @map("period_id")
  receiptDate DateTime      @map("receipt_date") @db.Date
  supplier    String?       @db.VarChar(200)
  note        String?       @db.Text
  status      ReceiptStatus @default(DRAFT)
  createdById String        @map("created_by")
  approvedById String?      @map("approved_by")
  approvedAt  DateTime?     @map("approved_at") @db.DateTime(3)
  createdAt   DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.DateTime(3)

  period      InventoryPeriod? @relation(fields: [periodId], references: [id])
  createdBy   User            @relation("ReceiptCreatedBy", fields: [createdById], references: [id])
  approvedBy  User?           @relation("ReceiptApprovedBy", fields: [approvedById], references: [id])
  items       ReceiptItem[]

  @@map("receipts")
}

model ReceiptItem {
  id         String  @id @default(uuid())
  receiptId  String  @map("receipt_id")
  productId  String  @map("product_id")
  quantity   Decimal @db.Decimal(12, 2)
  unitPrice  Decimal @default(0) @map("unit_price") @db.Decimal(18, 2)
  totalValue Decimal @default(0) @map("total_value") @db.Decimal(18, 2)

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("receipt_items")
}

model Issue {
  id           String      @id @default(uuid())
  issueNo      String      @unique @map("issue_no") @db.VarChar(20)  // PX-2026-001
  periodId     String?     @map("period_id")
  issueDate    DateTime    @map("issue_date") @db.Date
  recipient    String?     @db.VarChar(200)
  department   String?     @db.VarChar(100)
  note         String?     @db.Text
  status       IssueStatus @default(DRAFT)
  createdById  String      @map("created_by")
  approvedById String?     @map("approved_by")
  confirmedById String?    @map("confirmed_by")
  approvedAt   DateTime?   @map("approved_at") @db.DateTime(3)
  confirmedAt  DateTime?   @map("confirmed_at") @db.DateTime(3)
  createdAt    DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.DateTime(3)

  period       InventoryPeriod? @relation(fields: [periodId], references: [id])
  createdBy    User  @relation("IssueCreatedBy", fields: [createdById], references: [id])
  approvedBy   User? @relation("IssueApprovedBy", fields: [approvedById], references: [id])
  confirmedBy  User? @relation("IssueConfirmedBy", fields: [confirmedById], references: [id])
  items        IssueItem[]
  issueRequest IssueRequest? @relation("IssueToRequest")

  @@map("issues")
}

model IssueRequest {
  id            String             @id @default(uuid())
  requestNo     String             @unique @map("request_no") @db.VarChar(20)
  periodId      String?            @map("period_id")
  requestDate   DateTime           @map("request_date") @db.Date
  reason        String?            @db.Text
  note          String?            @db.Text
  status        IssueRequestStatus @default(PENDING_APPROVAL)
  requestedById String             @map("requested_by")
  reviewedById  String?            @map("reviewed_by")
  reviewedAt    DateTime?          @map("reviewed_at") @db.DateTime(3)
  rejectReason  String?            @map("reject_reason") @db.Text
  issueId       String?            @unique @map("issue_id")
  createdAt     DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.DateTime(3)

  period      InventoryPeriod?   @relation(fields: [periodId], references: [id])
  requestedBy User               @relation("IssueRequestedBy", fields: [requestedById], references: [id])
  reviewedBy  User?              @relation("IssueReviewedBy", fields: [reviewedById], references: [id])
  issue       Issue?             @relation("IssueToRequest", fields: [issueId], references: [id])
  items       IssueRequestItem[]

  @@map("issue_requests")
}

model IssueRequestItem {
  id             String   @id @default(uuid())
  issueRequestId String   @map("issue_request_id")
  productId      String   @map("product_id")
  requestedQty   Decimal  @map("requested_qty") @db.Decimal(12, 2)
  note           String?  @db.VarChar(200)

  issueRequest IssueRequest @relation(fields: [issueRequestId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id])

  @@map("issue_request_items")
}

model Notification {
  id         String           @id @default(uuid())
  userId     String           @map("user_id")
  type       NotificationType
  title      String           @db.VarChar(200)
  message    String           @db.Text
  isRead     Boolean          @default(false) @map("is_read")
  entityId   String?          @map("entity_id")
  entityType String?          @map("entity_type")
  createdAt  DateTime         @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model IssueItem {
  id           String   @id @default(uuid())
  issueId      String   @map("issue_id")
  productId    String   @map("product_id")
  requestedQty Decimal  @map("requested_qty") @db.Decimal(12, 2)
  actualQty    Decimal? @map("actual_qty") @db.Decimal(12, 2)  // NV kho điền khi confirm
  unitPrice    Decimal  @default(0) @map("unit_price") @db.Decimal(18, 2)

  issue   Issue   @relation(fields: [issueId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("issue_items")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String   @db.VarChar(50)   // CREATE_RECEIPT, APPROVE_ISSUE, ...
  entityType String?  @map("entity_type") @db.VarChar(50)
  entityId   String?  @map("entity_id")
  oldData    Json?    @map("old_data")
  newData    Json?    @map("new_data")
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)

  user User? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

