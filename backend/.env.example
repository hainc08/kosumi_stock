# Option A (recommended for production): set full URL
# DATABASE_URL=mysql://wms_user:wms_secret@localhost:3306/wms_db

# Option B (simple split vars): app will auto-build DATABASE_URL
DB_HOST=localhost
DB_PORT=3306
DB_USER=wms_user
DB_PASS=wms_secret
DB_NAME=wms_db

JWT_SECRET=change-this-to-minimum-32-char-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
PORT=3001
NODE_ENV=development
# Accept both names; CORS_ORIGIN has priority if both exist
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
BCRYPT_ROUNDS=12
